# .gitignore
# =============================================================================

# 1. Python virtual environments and caches
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# 2. Local environment secrets (NEVER UPLOAD THESE)
.env
pipeline_config.py.bak
docker/.env

# 3. Airflow runtime artifacts and logs
airflow/logs/
airflow/plugins/
airflow/unittests.cfg
airflow/*.db

# 4. OS metadata and local caches
.DS_Store
Thumbs.db
.dbt/
nairobi_dbt/target/
nairobi_dbt/dbt_packages/
nairobi_dbt/logs/

# root logs
logs/
# IDE
.vscode/
.idea/